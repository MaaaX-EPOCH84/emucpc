# Writes OUTPUT (a C++ header defining emucpc::version) from `git describe`
# in SOURCE_DIR, only when the text changes, so that an unchanged version
# does not trigger a rebuild. Run with cmake -P at each build.

set(version "unknown")
find_package(Git QUIET)
if(GIT_FOUND)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" describe --always --dirty
        WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE described
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
        RESULT_VARIABLE failed)
    if(NOT failed AND described)
        set(version "${described}")
    endif()
endif()

set(text "// Generated by cmake/version.cmake: do not edit.\n#pragma once\n\nnamespace emucpc {\ninline constexpr char version[] = \"${version}\";\n}\n")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old)
else()
    set(old "")
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUTPUT}" "${text}")
endif()
